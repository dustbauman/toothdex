{
  "expo": {
    "name": "toothdex",
    "slug": "toothdex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "toothdex",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B1B2B"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "ToothDex needs photo library access to pick tooth images for identification.",
        "NSCameraUsageDescription": "ToothDex needs camera access to photograph teeth for identification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0B1B2B"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ToothDex to access your photos to pick a tooth image.",
          "cameraPermission": "Allow ToothDex to use the camera to photograph a tooth."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
